# ==========================================================
# TruthLens Backend Configuration & API Keys
# ==========================================================

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# ----------------------------------------------------------
# External Search / Evidence Retrieval API Keys
# Choose one or more providers: Tavily, Google Custom Search, Serper
# If left blank, TruthLens uses the heuristic evidence engine
# ----------------------------------------------------------
TAVILY_API_KEY=
SERPER_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# ----------------------------------------------------------
# External LLM / Reasoning Synthesis API Keys
# Gemini or OpenAI can be configured for deep stance evaluation
# If left blank, TruthLens uses structured deterministic synthesis
# ----------------------------------------------------------
GEMINI_API_KEY=
OPENAI_API_KEY=
